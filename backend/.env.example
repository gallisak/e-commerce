NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
TRUST_PROXY=0

CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=5
CATALOG_CACHE_TTL_SECONDS=300

THROTTLE_LIMIT=300
THROTTLE_TTL_SECONDS=60
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_SECONDS=60

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345!
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=Customer12345!
