NODE_ENV=development
PORT=3000

# Inside docker-compose the host is "postgres"; for local runs use "localhost"
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
